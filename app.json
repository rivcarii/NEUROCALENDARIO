{
  "expo": {
    "name": "NeuroCalendario",
    "slug": "neurocalendario",
    "scheme": "neurocalendario",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.neurocalendario.local",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Se usa para proteger el acceso a la información de salud.",
        "NSCameraUsageDescription": "Se usa para fotografiar documentos médicos que usted decida adjuntar.",
        "NSPhotoLibraryUsageDescription": "Se usa para adjuntar imágenes de documentos médicos que usted elija."
      }
    },
    "android": {
      "package": "app.neurocalendario.local",
      "adaptiveIcon": {
        "backgroundColor": "#4C46D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_BIOMETRIC"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#4C46D6"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "NeuroCalendario",
      "shortName": "NeuroCal",
      "themeColor": "#F2F2F7",
      "backgroundColor": "#F2F2F7"
    }
  }
}
